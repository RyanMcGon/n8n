          },
          "messages": {
            "values": [
              {
                "message": "You are a professional roof inspector. Analyze the image of the roof I'm providing and assess the following:\n\n1. Identify any visible damage (missing shingles, leaks, structural issues, etc.)\n2. Rate the severity of the damage on a scale of 1-10\n3. Provide an estimated price range to fix the issues identified\n4. List recommended repairs and maintenance\n\nBe specific and professional in your assessment.",
                "role": "system"
              },
              {
                "message": "Please analyze this roof image:",
                "role": "user",
                "mediaItems": [
                  {
                    "type": "image",
                    "data": "={{$json[\"imageUrl\"]}}"
                  }
                ]
              }
            ]
          }
        },
