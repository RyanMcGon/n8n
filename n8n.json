      {
        "parameters": {
          "functionCode": "// Extract image URL from the query parameters\nconst imageUrl = $input.item.json.query.imageUrl;\n\nif (!imageUrl) {\n  return {\n    json: {\n      success: false,\n      error: \"No image URL provided. Please include 'imageUrl' as a query parameter.\"\n    }\n  };\n}\n\n// Return the validated image URL for next nodes to use\nreturn {\n  json: {\n    success: true,\n    imageUrl: imageUrl\n  }\n};"
        },
        "id": "97db53e5-dc67-4c96-bb2c-3d12c8d2ddcb",
        "name": "Extract Image URL",
        "type": "n8n-nodes-base.function",
        "typeVersion": 1,
