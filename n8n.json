          460,
          300
        ]
      },
      {
        "parameters": {
          "conditions": {
            "string": [
              {
                "value1": "={{$json[\"success\"]}}",
                "operation": "equal",
                "value2": true
              }
            ]
          }
        },
        "id": "e3d12be9-f857-4b32-a76e-83e79af7b5b9",
